{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Bilişim Ajans Ücretsiz Araçlar — tasarım token'ları (W3C Design Tokens biçimi). Tek gerçek kaynak budur; web/assets/css/ba.css :root bloğu bu dosyayla eşleşmelidir. Denetim: npm run tokens:check",
  "meta": {
    "archetype": "Precision-Industrial",
    "source": "https://bilisimajans.com (3 Kasım 2026 incelemesi, docs/TASARIM.md)",
    "parameters": { "DESIGN_VARIANCE": 6, "MOTION_INTENSITY": 6, "VISUAL_DENSITY": 5, "TACTILE_DEPTH": 7 }
  },
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#7b2331", "$extensions": { "ba.css": "--ba-primary", "dark": "#e07a93", "oklch": "oklch(0.37 0.13 12)" } },
      "primary-strong": { "$type": "color", "$value": "#5e1a25", "$extensions": { "ba.css": "--ba-primary-strong", "dark": "#f0a0b3" } },
      "primary-soft": { "$type": "color", "$value": "#f6e9ec", "$extensions": { "ba.css": "--ba-primary-soft", "dark": "#3a1c23" } },
      "accent": { "$type": "color", "$value": "#a5475a", "$extensions": { "ba.css": "--ba-accent", "dark": "#e8a0b3" } }
    },
    "surface": {
      "bg": { "$type": "color", "$value": "#ffffff", "$extensions": { "ba.css": "--ba-bg", "dark": "#1a1c1f" } },
      "card": { "$type": "color", "$value": "#ffffff", "$extensions": { "ba.css": "--ba-surface", "dark": "#23262b" } },
      "alt": { "$type": "color", "$value": "#f6f5f3", "$extensions": { "ba.css": "--ba-surface-2", "dark": "#2f3237" } },
      "ink": { "$type": "color", "$value": "#1f2226", "$extensions": { "ba.css": "--ba-ink" } },
      "ink-2": { "$type": "color", "$value": "#2f3237", "$extensions": { "ba.css": "--ba-ink-2" } },
      "ink-border": { "$type": "color", "$value": "#3d4046", "$extensions": { "ba.css": "--ba-ink-border" } }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#1e2126", "$extensions": { "ba.css": "--ba-text", "dark": "#f3f4f6" } },
      "secondary": { "$type": "color", "$value": "#45484e", "$extensions": { "ba.css": "--ba-text-2", "dark": "#c3c4c7" } },
      "muted": { "$type": "color", "$value": "#63666c", "$extensions": { "ba.css": "--ba-text-muted", "dark": "#a6a8ad", "contrastOnWhite": "5.4:1" } },
      "on-ink": { "$type": "color", "$value": "#ffffff", "$extensions": { "ba.css": "--ba-on-ink" } },
      "on-ink-2": { "$type": "color", "$value": "#c3c4c7", "$extensions": { "ba.css": "--ba-on-ink-2" } },
      "on-ink-muted": { "$type": "color", "$value": "#a6a8ad", "$extensions": { "ba.css": "--ba-on-ink-muted" } }
    },
    "border": {
      "default": { "$type": "color", "$value": "#e3e1df", "$extensions": { "ba.css": "--ba-border", "dark": "#3d4046" } },
      "hover": { "$type": "color", "$value": "#cbc7c4", "$extensions": { "ba.css": "--ba-border-hover", "dark": "#55585e" } }
    },
    "status": {
      "success": { "$type": "color", "$value": "#1f7a4d", "$extensions": { "ba.css": "--ba-success", "dark": "#6fcf97" } },
      "success-soft": { "$type": "color", "$value": "#e6f4ec", "$extensions": { "ba.css": "--ba-success-soft", "dark": "#17301f" } },
      "danger": { "$type": "color", "$value": "#a3271f", "$extensions": { "ba.css": "--ba-danger", "dark": "#ff8a80" } },
      "danger-soft": { "$type": "color", "$value": "#fbe9e7", "$extensions": { "ba.css": "--ba-danger-soft", "dark": "#3a1a18" } }
    },
    "cmyk": {
      "c": { "$type": "color", "$value": "#00aeef", "$extensions": { "ba.css": "--ba-cmyk-c" } },
      "m": { "$type": "color", "$value": "#ec008c", "$extensions": { "ba.css": "--ba-cmyk-m" } },
      "y": { "$type": "color", "$value": "#ffe000", "$extensions": { "ba.css": "--ba-cmyk-y" } }
    },
    "shine": {
      "$description": "Ana sitedeki .bkx-grad ile aynı parlayan başlık gradyanı (beyaz → cam göbeği → pembe → amber → beyaz).",
      "stops": { "$type": "color", "$value": ["#ffffff", "#7fd3f5", "#f28cc8", "#ffd27a", "#ffffff"] }
    }
  },
  "typography": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["IBM Plex Sans", "Segoe UI", "system-ui", "-apple-system", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "$extensions": { "ba.css": "--ba-font", "note": "Dış font yüklenmez (CLAUDE.md). Plex yüklüyse kullanılır, yoksa Segoe UI / system-ui." } },
      "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "Cascadia Mono", "Consolas", "monospace"], "$extensions": { "ba.css": "--ba-mono" } }
    },
    "heading": {
      "h1": { "$type": "typography", "$value": { "fontSize": "clamp(34px, 4.6vw, 56px)", "lineHeight": 1.07, "fontWeight": 600, "letterSpacing": "-0.025em" } },
      "h2": { "$type": "typography", "$value": { "fontSize": "clamp(26px, 3.2vw, 38px)", "lineHeight": 1.15, "fontWeight": 600, "letterSpacing": "-0.02em" } },
      "eyebrow": { "$type": "typography", "$value": { "fontFamily": "{typography.family.mono}", "fontSize": "12px", "letterSpacing": "0.16em", "textTransform": "uppercase" } }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px", "$extensions": { "ba.css": "--ba-radius-sm", "use": "buton, giriş alanı, sekme" } },
    "md": { "$type": "dimension", "$value": "8px", "$extensions": { "ba.css": "--ba-radius", "use": "kart, SSS" } },
    "lg": { "$type": "dimension", "$value": "10px", "$extensions": { "ba.css": "--ba-radius-lg", "use": "CTA, araç kutusu" } }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": "0 1px 2px rgba(30, 33, 38, .05)", "$extensions": { "ba.css": "--ba-shadow-card" } },
    "hover": { "$type": "shadow", "$value": "0 10px 26px rgba(30, 33, 38, .09)", "$extensions": { "ba.css": "--ba-shadow-hover" } },
    "button": { "$type": "shadow", "$value": "0 1px 0 rgba(255, 255, 255, .12) inset, 0 6px 18px rgba(123, 35, 49, .20)", "$extensions": { "ba.css": "--ba-shadow-btn" } },
    "pop": { "$type": "shadow", "$value": "0 18px 44px rgba(30, 33, 38, .14)", "$extensions": { "ba.css": "--ba-shadow-pop" } }
  },
  "layout": {
    "max": { "$type": "dimension", "$value": "1200px", "$extensions": { "ba.css": "--ba-max" } },
    "gutter": { "$type": "dimension", "$value": "16px", "$extensions": { "ba.css": "--ba-gutter", "md": "24px" } }
  },
  "motion": {
    "$description": "Ana sitedeki hareket dili: kaydırmada sıralı açılış, yay etkili nokta büyümesi, 6.8 sn'lik adım döngüsü, 7 sn'lik başlık parıltısı. prefers-reduced-motion: reduce → tüm hareket kapalı.",
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms", "$extensions": { "ba.css": "--ba-dur-fast", "use": "hover, renk" } },
      "base": { "$type": "duration", "$value": "450ms", "$extensions": { "ba.css": "--ba-dur-base" } },
      "reveal": { "$type": "duration", "$value": "700ms", "$extensions": { "ba.css": "--ba-dur-reveal", "use": "kaydırmada açılış" } },
      "word": { "$type": "duration", "$value": "700ms", "$extensions": { "ba.css": "--ba-dur-word", "use": "başlık kelimeleri" } },
      "shine": { "$type": "duration", "$value": "7000ms", "$extensions": { "ba.css": "--ba-dur-shine" } },
      "cycle": { "$type": "duration", "$value": "6800ms", "$extensions": { "ba.css": "--ba-cycle", "use": "adım halkası döngüsü" } },
      "icon": { "$type": "duration", "$value": "3400ms", "$extensions": { "ba.css": "--ba-icon-cycle", "use": "araç ikonu döngüsü (bob, wiggle, pulse, swing, jump, spin)" } }
    },
    "stagger": { "$type": "duration", "$value": "70ms", "$extensions": { "ba.css": "--ba-stagger" } },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1], "$extensions": { "ba.css": "--ba-ease-out" } },
      "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$extensions": { "ba.css": "--ba-ease-spring" } },
      "inout": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1], "$extensions": { "ba.css": "--ba-ease-inout" } }
    },
    "distance": {
      "rise": { "$type": "dimension", "$value": "22px", "$extensions": { "ba.css": "--ba-rise" } }
    }
  }
}
